# Copy this file to .env and fill in your keys.
# Anything prefixed VITE_ is bundled into the public browser build, so it is
# visible to every visitor. Never put a real secret behind a VITE_ prefix.

# --- Client (public, VITE_) ---
VITE_PEXELS_API_KEY=your_pexels_api_key_here
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_OPENWEATHER_KEY=your_openweather_key_here
# VITE_GOOGLE_MAPS_KEY is no longer used for venue/supplier search. Those now
# go through the server function below so the key stays private.

# --- Server only (set in Netlify -> Site settings -> Environment, NOT here) ---
# These are read by netlify/functions/places-search.js and must have NO VITE_
# prefix so they never reach the browser:
#   SUPABASE_URL                same value as VITE_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY   Supabase -> Project Settings -> API -> service_role (SECRET)
#   GOOGLE_PLACES_SERVER_KEY    a Places API key with NO referrer restriction (SECRET)
